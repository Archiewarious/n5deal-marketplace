# Required. Both are safe to expose: the publishable key is what the browser already ships,
# and every table behind it is closed by row level security.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional. Without it the app runs completely: the search box falls back to its deterministic
# parser and the "Check before publishing" button does not appear. Server-side only, with no
# NEXT_PUBLIC_ prefix — src/lib/ai.ts imports 'server-only' so a leak is a build failure.
GEMINI_API_KEY=
