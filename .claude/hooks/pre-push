#!/bin/sh
# Git-хук pre-push: не дати виїхати в ПРОД зламаному.
#
# Навіщо. Пуш у main = деплой на два воркери Cloudflare (див. CLAUDE.md). Єдина
# перевірка зараз — CI, і вона спрацьовує ВЖЕ ПІСЛЯ пушу: зламане встигає поїхати.
# typecheck+lint+тести локально займають ~1 хв — це прийнятна ціна за пуш, який
# трапляється кілька разів на день.
#
# Встановлення (виконати ОДИН раз, вручну — хук у git не комітиться сам):
#   git config core.hooksPath .claude/hooks
# ⚠️ Імʼя файла — РІВНО pre-push, без розширення: git шукає саме його. Із .sh хук тихо
# не викликається взагалі — виглядає як «увімкнено», а насправді ні (спіймано 13.08).
# Обійти свідомо (коли пушиш лише .md):
#   git push --no-verify

set -e

echo "── pre-push: typecheck ─────────────────────────────"
npm run typecheck

# ⚠️ ОКРЕМИЙ ПРОХІД ПО ТЕСТАХ (14.08.2026). Основний tsconfig їх ВИКЛЮЧАЄ, тож тест,
# який кличе функцію зі старою сигнатурою, лишався зеленим «по збігу» — і замок,
# написаний під цю функцію, ставав беззубим. За 13-14.08 скептик ловив це двічі.
echo "── pre-push: typecheck тестів ──────────────────────"
npm run typecheck:tests

echo "── pre-push: lint ──────────────────────────────────"
npm run lint

echo "── pre-push: tests ─────────────────────────────────"
npm test

echo "✅ pre-push: усе зелене, пушимо"
